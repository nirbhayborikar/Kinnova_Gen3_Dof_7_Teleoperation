<?xml version="1.0"?>

<!-- stolen from https://github.com/Hlwy/gazebo_sensor_collection -->
<robot name="sensor_orbbec_astra" xmlns:xacro="http://ros.org/wiki/xacro">

     <xacro:property name="orbbec_astra_scale" value="1.0"/>
     <!-- RGB sensor - cam -->
     <xacro:property name="orbbec_astra_rel_rgb_px"   value="0.0" />
     <xacro:property name="orbbec_astra_rel_rgb_py"   value="-0.0125" />
     <xacro:property name="orbbec_astra_rel_rgb_pz"   value="-0.0150" />
     <!-- IR sensor - depth -->
     <xacro:property name="orbbec_astra_depth_rel_rgb_px" value="0.0" />
     <xacro:property name="orbbec_astra_depth_rel_rgb_py" value="0.0250" />
     <xacro:property name="orbbec_astra_depth_rel_rgb_pz" value="0.0" />
     <xacro:property name="M_PI" value="3.1415926535897931" />


     <xacro:macro name="sensor_orbbec_astra" params="name parent x y z roll pitch yaw">

          <joint name="${name}_rgb_joint" type="fixed">
               <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
               <parent link="${parent}"/>
               <child link="${name}_rgb_frame" />
          </joint>

          <link name="${name}_rgb_frame">
               <inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial>
          </link>

          <joint name="${name}_rgb_optical_joint" type="fixed">
               <origin xyz="0.0 0.0 0.0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
               <parent link="${name}_rgb_frame" />
               <child link="${name}_rgb_optical_frame" />
          </joint>

          <link name="${name}_rgb_optical_frame">
               <!--inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial-->
          </link>

          <joint name="${name}_joint" type="fixed">
               <origin xyz="${orbbec_astra_rel_rgb_px} ${orbbec_astra_rel_rgb_py} ${orbbec_astra_rel_rgb_pz}" rpy="0.0 0 0"/>
               <parent link="${name}_rgb_frame"/>
               <child link="${name}_link"/>
          </joint>

          <link name="${name}_link">
               <visual>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry>
                         <mesh filename="file://$(find astra_description)/meshes/orbbec_astra.dae" scale="${orbbec_astra_scale} ${orbbec_astra_scale} ${orbbec_astra_scale}"/>
                    </geometry>
                    <material name="AstraBlack">
                        <color rgba="0 0 0 1.0"/>
                    </material>
               </visual>
               <collision>
                    <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
                    <geometry>
                         <box size="0.0730 .2760 0.0720"/>
                    </geometry>
               </collision>
               <inertial>
                    <mass value="0.564" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257" />
               </inertial>
          </link>

          <joint name="${name}_depth_joint" type="fixed">
               <origin xyz="${orbbec_astra_depth_rel_rgb_px} ${orbbec_astra_depth_rel_rgb_py} ${orbbec_astra_depth_rel_rgb_pz}" rpy="0 0 0" />
               <parent link="${name}_rgb_frame" />
               <child link="${name}_depth_frame" />
          </joint>

          <link name="${name}_depth_frame">
               <!--inertial>
                    <mass value="0.01" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
               </inertial-->
          </link>

          <joint name="${name}_depth_optical_joint" type="fixed">
               <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
               <parent link="${name}_depth_frame" />
               <child link="${name}_depth_optical_frame" />
          </joint>

          <link name="${name}_depth_optical_frame">
               <!--inertial>
                    <mass value="0.001" />
                    <origin xyz="0 0 0" />
                    <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
               </inertial-->
          </link>


     </xacro:macro>
</robot>
